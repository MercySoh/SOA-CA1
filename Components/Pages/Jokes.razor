@using RestSharp;
@using System.Text.Json;

@* reference: https://stackoverflow.com/questions/78097987/cannot-invoke-method-with-onclick-in-blazor-button-component *@
@* reference: https://learn.microsoft.com/en-us/aspnet/core/blazor/components/render-modes?view=aspnetcore-8.0 *@
@* rendermode Required for version 8 *@
@rendermode @(new InteractiveServerRenderMode(false))

@page "/jokes"

<PageTitle>Jokes</PageTitle>

<h1>Jokes Collection</h1><br>

<h5 >Click button to show a random joke.</h5><button @onclick="GetRandomJoke">Get random joke</button>
<br>

@if (randomJoke != null)
{
	<div style="border:double">
		<h6 style="font-weight:bold">Random Joke</h6>
		<p>@randomJoke.setup</p>
		<p>@randomJoke.punchline</p>
	</div>
}
<br>

<h5>Click button to show 10 random joke.</h5><button @onclick="Get10RandomJoke">Get 10 random joke</button>
<br>

@{
	var n = 1;
}
@if (tenJoke != null)
{
	<div style="border:double">
		<h6 style="font-weight:bold">Ten Random Joke:</h6>
		<ul>
			@foreach (var joke in tenJoke)
			{
				<p>@n</p>
				<p>@joke.setup</p>
				<p>@joke.punchline</p>

				n++;
			}
		</ul>
	</div>
	
}

@code {

	public static Joke randomJoke;
	public static Joke[] tenJoke;

	public HttpClient httpClient = new HttpClient();

	public async Task GetRandomJoke()
	{
		randomJoke = await httpClient.GetFromJsonAsync<Joke>("https://official-joke-api.appspot.com/jokes/random");
	}

	public async Task Get10RandomJoke()
	{
		tenJoke = await httpClient.GetFromJsonAsync<Joke[]>("https://official-joke-api.appspot.com/random_ten");
	}
	
	public class Joke
	{
		public string type { get; set; }
		public string setup { get; set; }
		public string punchline { get; set; }
		public int id { get; set; }
	}
}
