@using RestSharp;
@using System.Text.Json;

@* reference: https://stackoverflow.com/questions/78097987/cannot-invoke-method-with-onclick-in-blazor-button-component *@
@* reference: https://learn.microsoft.com/en-us/aspnet/core/blazor/components/render-modes?view=aspnetcore-8.0 *@
@* rendermode Required for version 8 *@
@rendermode @(new InteractiveServerRenderMode(false))

@page "/quotes"

<h1>Quotes Collection</h1><br>

<h5>Click button to get Today's Quote.</h5><button @onclick="FetchToday">Get Today's Quote</button>
<br>

@* today's quote *@
@if (todaysQuotes != null)
{
	<div style="border:dotted">
		<h6 style="font-weight:bold">Today's quote</h6>
		<ul>
			@foreach (var quote in todaysQuotes)
			{
					<p >@quote.a</p>
					<p style="font-style:italic">@quote.q</p>
			}
		</ul>
	</div>
	
}

<br>

<h5>Click button to get a random Quote.</h5><button @onclick="FetchRandom">Get Random Quote</button>
<br>

@* random quote *@
@if (randomQuotes != null)
{
	<div style="border:dotted">
		<h6 style="font-weight:bold">Random quote</h6>
		<ul>
			@foreach (var quote in randomQuotes)
			{
				<p>@quote.a</p>
				<p style="font-style:italic">@quote.q</p>
			}
		</ul>
	</div>
	
}

<br>

<h5>Click button to get 50 random Quote.</h5><button @onclick="FetchQuotes">Get Quote</button>
<br>

@* all quote *@
@{
	var x = 1;
}
@if (allQuotes != null)
{
	<div style="border:dotted">
		<h6 style="font-weight:bold">All quote</h6>
		<ul>
			@foreach (var quote in allQuotes)
			{
				<p>@x @quote.a</p>
			    <p style="font-style:italic">@quote.q</p>

				x++;
			}
		</ul>
	</div>
	
}

<br>

<h5>Try get all quotes service in one button!</h5><button @onclick="FetchEverything">Get All</button>


@code {

	public static ZenQuotes[] todaysQuotes;
	public static ZenQuotes[] randomQuotes;
	public static ZenQuotes[] allQuotes;

	public HttpClient httpClient = new HttpClient();

	//service: get today's qoute api
	public async Task FetchToday()
	{
		todaysQuotes = await httpClient.GetFromJsonAsync<ZenQuotes[]>("https://zenquotes.io/api/today");
	}

	//service: get random qoute api
	public async Task FetchRandom()
	{
		randomQuotes = await httpClient.GetFromJsonAsync<ZenQuotes[]>("https://zenquotes.io/api/random");
	}

	//service: get all qoutes up to 50
	public async Task FetchQuotes()
	{
		allQuotes = await httpClient.GetFromJsonAsync<ZenQuotes[]>("https://zenquotes.io/api/quotes");
	}

	//service: get everything in one button
	public async Task FetchEverything()
	{
		await FetchQuotes();
		await FetchToday();
		await FetchRandom();
	}

	public class ZenQuotes
	{
		//ZenQuotes AIP resouce: https://zenquotes.io/

		//q = quotes
		public string q { get; set; }
		//a = author
		public string a { get; set; }
		//c = character count
		public string c { get; set; }
		//h = pre-formatted HTML quote
		public string h { get; set; }

	}
}
